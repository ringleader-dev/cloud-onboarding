# Copy to terraform.tfvars and edit. Ringleader gives you issuer_url and org_uid.
subscription_id       = "00000000-0000-0000-0000-000000000000"
resource_group_name   = "ringleader-workstations"
ringleader_issuer_url = "https://oidc-app.ringleader.dev"
org_uid               = "0192f5bf-af83-7178-8d0a-f1c7aea06bde"

# EVERYTHING BELOW IS ON BY DEFAULT. Uncomment a line only to turn something off.
# The root README has the full list: ../../../README.md

# The landing pad: a vnet + subnet + NAT gateway + NSG. On Azure a workstation has NO public IP
# unless you ask for one, so without a NAT gateway it has no egress and never comes up -- which
# is why this is the default here. The NAT gateway and its public IP bill per hour. Set false
# only if you already have a subnet with egress for these VMs.
# create_network = false

# WHO CAN SSH IN -- the one thing that is NOT on by default, and cannot be. Ringleader has no
# bastion: `rl shell`, tmux, port-forwards and VS Code Web all dial the workstation on TCP 22.
# With this empty, workstations come up and report Ready but nobody can open them -- correct
# only if you reach the VNet privately (VPN / ExpressRoute / peering).
# ssh_source_ranges = ["203.0.113.0/24"]   # the CIDRs your engineers connect from

# The secondary SSH port follows ssh_source_ranges unless you set this. Some Ringleader
# workstation types run their own SSH daemon on it (the VM's own sshd keeps 22) and `rl shell`
# dials it for them; for the types that do not, the rule is harmless. Set [] to close it. On
# Azure an NSG covers the whole subnet, so these ranges are the only narrowing available.
# secondary_ssh_source_ranges = []

# Let Ringleader provision a per-user managed identity per workstation and assign roles to it.
# Adds Microsoft.Authorization/roleAssignments/write, which built-in Contributor does not carry
# -- still scoped to this one resource group.
# enable_workstation_identities = false

# Let Ringleader manage the NSGs an egress policy compiles to, and the route tables and subnets
# that steer traffic at the DNS / HTTPS proxy. Adds sixteen actions to the custom role, still
# scoped to this resource group. It restricts nothing until you declare an egress policy on a
# workstation. Note the NSGs attach to the NIC, so unlike the inbound rules above they really
# are per workstation.
# enable_egress_control = false

# An empty subnet (10.70.240.0/24) reserved for the DNS / HTTPS proxy VM that hostname-level
# egress control will use. The VM does not exist yet; the subnet costs nothing, shares the NAT
# gateway, and saves renumbering later.
# create_gateway_subnet = false

# The subnet the workstations that proxy GOVERNS go in (10.70.224.0/20). It carries the
# workstations NSG, so `rl shell` still reaches a box in it, and deliberately neither a route
# table nor the NAT gateway -- a governed box's egress is the proxy's job. Name it as
# providerConfig.azure.subnetId on the workstations that carry an egress policy; mixing
# governed and ungoverned boxes in one subnet is what Ringleader refuses.
# create_governed_subnet = false

# Where the landing pad goes. Defaults to eastus; set it per region.
# location = "eastus"

# WHICH RANGE THIS REGION TAKES. Required whenever the landing pad is created (above) and you
# have not set vnet_address_space below -- from ONE region onwards, not just from two. Index 0
# is 10.70.0.0/16, the range this module has always created, so naming your location at 0
# changes nothing.
region_indexes = {
  "eastus" = 0
}

# PLANNING A SECOND REGION? Add it here and use the SAME map in every region's tfvars. The
# module looks up location above, so index 1 takes 10.71.0.0/16 and every subnet follows --
# there is nothing else to keep in step, and the two applies cannot land on one range whichever
# order you run them in. Copy this file to a second region and forget to extend the map and the
# plan FAILS, naming the location.
#
# This matters before the first apply, not when you need the second region: an Azure VNet is
# regional, a second region is a second VNet, and global VNet peering cannot join overlapping
# address spaces. Two regions on one range can never be peered and the only fix is to renumber
# and re-onboard.
#
# region_indexes = {
#   "eastus"     = 0
#   "westeurope" = 1
# }

# Bringing your own IPAM instead? Set vnet_address_space and the subnets are carved out of it;
# region_indexes is then ignored and keeping every region distinct is yours to do.
# vnet_address_space = "10.70.0.0/16"

# ...AND REUSE THE IDENTITY. The ranges are only half of a second region. An Entra app
# registration is tenant-wide while the custom role is scoped to ONE resource group, so a second
# region left on the defaults mints a SECOND app registration -- a second client id to hand back,
# and neither identity able to act in the other's group. The first region creates the identity;
# every region after it reuses that one and deploys only the role and the landing pad into its own
# group. Both ids come from the FIRST region's outputs.
#
# create_identity              = false
# existing_client_id           = "00000000-0000-0000-0000-000000000000"  # terraform output target_app_client_id
# existing_principal_object_id = "00000000-0000-0000-0000-000000000000"  # terraform output service_principal_object_id
