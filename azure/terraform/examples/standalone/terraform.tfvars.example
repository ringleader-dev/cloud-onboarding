# Copy to terraform.tfvars and edit. Ringleader gives you issuer_url and org_uid.
subscription_id       = "00000000-0000-0000-0000-000000000000"
resource_group_name   = "ringleader-workstations"
ringleader_issuer_url = "https://oidc-app.ringleader.dev"
org_uid               = "0192f5bf-af83-7178-8d0a-f1c7aea06bde"

# Set true only if you do NOT already have a subnet for the VMs. On Azure a workstation has NO
# public IP unless you ask for one, so without a NAT gateway it has no egress and will never
# come up -- this landing pad provides it:
# create_network = true

# WHO CAN SSH IN. Ringleader has no bastion: `rl shell`, tmux, port-forwards and VS Code Web all
# dial the workstation on TCP 22. With this empty, workstations come up and report Ready but
# NOBODY can open them -- correct only if you reach the VNet privately
# (VPN / ExpressRoute / peering).
# ssh_source_ranges = ["203.0.113.0/24"]   # the CIDRs your engineers connect from

# A SECOND SSH PORT, off unless you set this. Some Ringleader workstation types run their own SSH
# daemon on a secondary port inside the VM (the VM's own sshd keeps 22), and `rl shell` dials that
# port for them. Ringleader tells you if the workstations you plan to run need it; leaving this
# empty opens nothing and changes nothing. On Azure an NSG covers the whole subnet, so these
# ranges are the only narrowing available -- the rule admits the port to every VM on it.
# secondary_ssh_source_ranges = ["203.0.113.0/24"]

# Let Ringleader provision a per-user managed identity per workstation and assign roles to it.
# Adds Microsoft.Authorization/roleAssignments/write, which built-in Contributor does NOT have.
# enable_workstation_identities = true

# EGRESS CONTROL, off unless you set this. Lets Ringleader manage the network security groups
# that restrict where your workstations may connect -- an allowlist you declare per workstation.
# Adds seven NSG actions to the custom role, still scoped to this resource group. Off changes
# nothing. Note these attach to the NIC, so unlike the inbound rules above they really are
# per workstation.
# enable_egress_control = true

# Reserve an empty subnet (10.70.240.0/24 by default) for the DNS / HTTPS proxy VM that
# hostname-level egress control will use. The VM does not exist yet; the subnet costs nothing,
# shares the NAT gateway, and saves renumbering later. Needs create_network.
# create_gateway_subnet = true

# PLANNING A SECOND REGION? Set vnet_address_space per region BEFORE the first apply. An Azure
# VNet is regional, and global VNet peering cannot join overlapping address spaces.
#   first region  10.70.0.0/16, second 10.71.0.0/16, third 10.72.0.0/16 ...
# vnet_address_space = "10.70.0.0/16"
