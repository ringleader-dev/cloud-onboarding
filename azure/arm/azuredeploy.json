{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "principalId": {
      "type": "String",
      "metadata": {
        "description": "Object id of the service principal to grant the role to (az ad sp show --id <appId> --query id -o tsv)."
      }
    },
    "roleName": {
      "type": "String",
      "defaultValue": "Ringleader Workstation Operator",
      "metadata": {
        "description": "Display name of the custom role."
      }
    },
    "enableWorkstationIdentities": {
      "type": "Bool",
      "defaultValue": false,
      "metadata": {
        "description": "Let Ringleader provision a per-user managed identity and assign roles to it. Adds the Microsoft.ManagedIdentity CRUD/assign actions and Microsoft.Authorization roleAssignments write, which built-in Contributor does not have either. Leave false unless you use the feature; left off it fails closed with a 403."
      }
    },
    "enableEgressControl": {
      "type": "Bool",
      "defaultValue": false,
      "metadata": {
        "description": "Let Ringleader manage the network security groups that restrict where workstations may connect. Adds NSG and security-rule read/write/delete plus join/action, which is what lets Ringleader attach a group to a workstation NIC. Still scoped to this resource group. Leave false unless you use egress control; left off it fails closed with a 403."
      }
    }
  },
  "variables": {
    "roleDefinitionGuid": "[guid(resourceGroup().id, parameters('roleName'))]",
    "actions": [
      "Microsoft.Compute/virtualMachines/read",
      "Microsoft.Compute/virtualMachines/write",
      "Microsoft.Compute/virtualMachines/delete",
      "Microsoft.Compute/virtualMachines/start/action",
      "Microsoft.Compute/virtualMachines/powerOff/action",
      "Microsoft.Compute/virtualMachines/deallocate/action",
      "Microsoft.Compute/virtualMachines/restart/action",
      "Microsoft.Compute/virtualMachines/instanceView/read",
      "Microsoft.Compute/disks/read",
      "Microsoft.Compute/disks/write",
      "Microsoft.Compute/disks/delete",
      "Microsoft.Compute/locations/vmSizes/read",
      "Microsoft.Compute/locations/usages/read",
      "Microsoft.Network/networkInterfaces/read",
      "Microsoft.Network/networkInterfaces/write",
      "Microsoft.Network/networkInterfaces/delete",
      "Microsoft.Network/networkInterfaces/join/action",
      "Microsoft.Network/publicIPAddresses/read",
      "Microsoft.Network/publicIPAddresses/write",
      "Microsoft.Network/publicIPAddresses/delete",
      "Microsoft.Network/publicIPAddresses/join/action",
      "Microsoft.Network/virtualNetworks/read",
      "Microsoft.Network/virtualNetworks/subnets/read",
      "Microsoft.Network/virtualNetworks/subnets/join/action",
      "Microsoft.Resources/subscriptions/resourceGroups/read",
      "Microsoft.Resources/tags/write"
    ],
    "roleAssignmentGuid": "[guid(resourceGroup().id, parameters('principalId'), variables('roleDefinitionGuid'))]",
    "identityActions": [
      "Microsoft.ManagedIdentity/userAssignedIdentities/read",
      "Microsoft.ManagedIdentity/userAssignedIdentities/write",
      "Microsoft.ManagedIdentity/userAssignedIdentities/delete",
      "Microsoft.ManagedIdentity/userAssignedIdentities/assign/action",
      "Microsoft.Authorization/roleAssignments/read",
      "Microsoft.Authorization/roleAssignments/write",
      "Microsoft.Authorization/roleAssignments/delete",
      "Microsoft.Authorization/roleDefinitions/read"
    ],
    "egressActions": [
      "Microsoft.Network/networkSecurityGroups/read",
      "Microsoft.Network/networkSecurityGroups/write",
      "Microsoft.Network/networkSecurityGroups/delete",
      "Microsoft.Network/networkSecurityGroups/join/action",
      "Microsoft.Network/networkSecurityGroups/securityRules/read",
      "Microsoft.Network/networkSecurityGroups/securityRules/write",
      "Microsoft.Network/networkSecurityGroups/securityRules/delete"
    ],
    "actionsWithIdentities": "[if(parameters('enableWorkstationIdentities'), union(variables('actions'), variables('identityActions')), variables('actions'))]",
    "effectiveActions": "[if(parameters('enableEgressControl'), union(variables('actionsWithIdentities'), variables('egressActions')), variables('actionsWithIdentities'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/roleDefinitions",
      "apiVersion": "2022-04-01",
      "name": "[variables('roleDefinitionGuid')]",
      "properties": {
        "roleName": "[parameters('roleName')]",
        "description": "Least-privilege role for Ringleader workstation VMs.",
        "type": "CustomRole",
        "permissions": [
          {
            "actions": "[variables('effectiveActions')]",
            "notActions": [],
            "dataActions": [],
            "notDataActions": []
          }
        ],
        "assignableScopes": [
          "[resourceGroup().id]"
        ]
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[variables('roleAssignmentGuid')]",
      "dependsOn": [
        "[resourceId('Microsoft.Authorization/roleDefinitions', variables('roleDefinitionGuid'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleDefinitionGuid'))]",
        "principalId": "[parameters('principalId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ]
}
