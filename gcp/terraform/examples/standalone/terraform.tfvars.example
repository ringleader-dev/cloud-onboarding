# Copy to terraform.tfvars and edit. Ringleader gives you issuer_url and org_uid.
project_id            = "my-company-dev-workstations"
ringleader_issuer_url = "https://oidc-app.ringleader.dev"
org_uid               = "0192f5bf-af83-7178-8d0a-f1c7aea06bde"

# Set true only if you do NOT already have a subnet for the VMs:
# create_network = true

# WHO CAN SSH IN. Ringleader has no bastion: `rl shell`, tmux, port-forwards and VS Code Web all
# dial the workstation on TCP 22. With this empty, workstations come up and report Ready but
# NOBODY can open them -- correct only if you reach the subnet privately
# (VPN / Interconnect / peering).
# ssh_source_ranges = ["203.0.113.0/24"]   # the CIDRs your engineers connect from

# A SECOND SSH PORT, off unless you set this. Some Ringleader workstation types run their own SSH
# daemon on a secondary port inside the VM (the VM's own sshd keeps 22), and `rl shell` dials that
# port for them. Ringleader tells you if the workstations you plan to run need it; leaving this
# empty opens nothing and changes nothing. The rule targets the ringleader-secondary-ssh network
# tag, so put that tag on those workstations ALONGSIDE ringleader-workstation:
#   providerConfig.gcp.networkTags: [ringleader-workstation, ringleader-secondary-ssh]
# secondary_ssh_source_ranges = ["203.0.113.0/24"]

# Let Ringleader CREATE a service account per workstation user and bind roles to it. Not needed to
# run workstations as an identity -- every workstation already runs as one (the project's default
# compute service account, unless it names its own).
# WARNING: grants roles/resourcemanager.projectIamAdmin, which can grant ANY role in this project
# to ANY principal (including roles/owner to itself). Dedicated projects only.
# enable_workstation_identities = true

# EGRESS CONTROL, off unless you set this. Lets Ringleader manage the VPC firewall rules that
# restrict where your workstations may connect -- an allowlist you declare per workstation.
# Grants a custom role with five compute.firewalls.* permissions and nothing else. Off changes
# nothing: workstations reach whatever your network routes, as they do today.
# enable_egress_control = true

# Reserve an empty subnet (10.60.240.0/24 by default) for the DNS / HTTPS proxy VM that
# hostname-level egress control will use. The VM does not exist yet; the subnet costs nothing
# and saves renumbering later. Needs create_network.
# create_gateway_subnet = true

# More regions in the SAME global VPC -- a GCP VPC is global, so this needs no peering and one
# proxy VM can serve every region. Each also gets its own Cloud Router and Cloud NAT.
# additional_regions = {
#   "europe-west1" = "10.60.16.0/20"
# }
