# Copy to terraform.tfvars and fill in. The two required values come from Ringleader.

# Ringleader's OIDC issuer origin (no trailing slash), from Ringleader.
ringleader_issuer_url = "https://oidc-app.ringleader.dev"

# Your Ringleader organization id (a lowercase UUID), from Ringleader.
org_uid = "0192f5bf-af83-7178-8d0a-f1c7aea06bde"

# Region for the landing-pad network and your workstations.
region = "us-east-1"

# WHO CAN SSH IN -- the one thing that is NOT on by default, and cannot be. Empty opens
# nothing (private reach only). Example: your office / VPN egress. 0.0.0.0/0 is accepted but
# is a decision, never one this module makes for you.
ssh_source_ranges = []

# ---------------------------------------------------------------------------------------
# EVERYTHING BELOW IS ON BY DEFAULT. Uncomment a line only to turn something off.
# The root README has the full list: ../../../README.md
# ---------------------------------------------------------------------------------------

# The secondary SSH port follows ssh_source_ranges unless you set this. Some Ringleader
# workstation types run their own SSH daemon on it (the instance's own sshd keeps 22) and
# `rl shell` dials it for them; for the types that do not, the rule is harmless. Set [] to
# close it.
# secondary_ssh_source_ranges = []

# The landing pad: a VPC + public subnet + internet gateway + security group. All free. Set
# false if you already have a subnet and security group for these VMs.
# create_network = false

# A NAT gateway plus a private route table, so an instance with no public IP still has egress.
# THE ONE DEFAULT THAT COSTS MONEY -- $0.045/hour plus $0.045/GB processed, whether or not
# anything uses it. Set false if every workstation gets a public IP (the default), which the
# internet gateway already serves for free. Once the DNS / HTTPS proxy ships, private
# workstations can egress through it instead and it meters nothing -- roughly $420/month
# cheaper at 10 TB.
# create_nat_gateway = false

# An empty PUBLIC subnet (10.60.240.0/24) plus its route table, reserved for the DNS / HTTPS
# proxy VM that hostname-level egress control will use. The VM does not exist yet; the subnet
# costs nothing and saves renumbering later. Public and in the workstations AZ are both cost
# decisions: internet ingress is free, and AWS charges cross-AZ traffic both ways.
# create_gateway_subnet = false

# Let Ringleader manage the security groups that restrict where workstations may connect.
# Bounded to the VPC this module creates; read the egress_scope output after applying to
# confirm. It restricts nothing until you declare an egress policy on a workstation.
# enable_egress_control = false

# Let Ringleader attach an instance profile to a workstation, so it runs as an IAM role.
# Grants iam:PassRole scoped to roles under /ringleader-workstations/ and to ec2 only -- with
# no roles under that path it reaches nothing.
# enable_workstation_identities = false

# PLANNING A SECOND REGION? Set vpc_cidr per region BEFORE the first apply. An AWS VPC is
# regional, and joining two regions later needs an inter-region Transit Gateway, which cannot
# route overlapping CIDRs -- so two regions on the default range can never be joined.
#   first region  10.60.0.0/16, second 10.61.0.0/16, third 10.62.0.0/16 ...
# vpc_cidr = "10.60.0.0/16"
